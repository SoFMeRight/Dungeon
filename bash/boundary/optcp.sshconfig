# Generated by hack/gen-boundary-sshconfig.py from the Boundary targets (POSIX). Include
# it from ~/.ssh/config and keep the optcp-cert script beside it; `ssh <target>` then
# refreshes the certificate and opens the session through Boundary.
Match host ant-parade,bluebell,cell-membrane,dungeon-pedestal,freightyard,harbormaster,homing-pigeon,jabu-jabu,moor,the-usual-suspect,xylem,dungeon-map-001,dungeon-map-002,dungeon-map-003,dungeon-map-004,dungeon-map-005,dungeon-chest-001,dungeon-chest-002,dungeon-chest-003,dungeon-chest-004,dungeon-chest-005 exec "sh %d/.ssh/optcp-cert.sh --no-login"
    IdentitiesOnly yes

Host ant-parade
    ProxyCommand boundary connect -addr https://access.optcp.com -target-name ant-parade -target-scope-name Hosts -exec nc -- {{boundary.ip}} {{boundary.port}}

Host bluebell
    ProxyCommand boundary connect -addr https://access.optcp.com -target-name bluebell -target-scope-name Hosts -exec nc -- {{boundary.ip}} {{boundary.port}}

