# This host's address, as other SeaweedFS nodes and clients are told to reach it.
# Must be routable from the cluster, never a container-internal address.
ADVERTISE_IP=172.22.150.101

# Where the data lives. No default in the compose — there is no safe guess.
DATA_DIR=/mnt/operation/PrecisionPlanIT/Servers/Gringotts/docker/seaweedfs/data

# Ports. The compose defaults to these already; they are stated here so the set
# in use is visible in one place and greppable against a firewall rule.
# SeaweedFS derives each gRPC port as its HTTP port + 10000 — move both together.
S3_PORT=8333
MASTER_PORT=9333
MASTER_GRPC_PORT=19333
VOLUME_PORT=8080
VOLUME_GRPC_PORT=18080
FILER_PORT=8888
FILER_GRPC_PORT=18888

# Capacity. 0 = unlimited volumes on this server.
VOLUME_MAX=1000
VOLUME_SIZE_LIMIT_MB=30000

# S3 identities. One per consumer, each scoped in docker-compose.yaml to its own
# prefix and nothing else. Nothing here is Admin.
# Names mirror the bucket path they open: uppercase, '/' -> '_'.
PRPLANIT_DUNGEON_VELERO_ACCESS_KEY=
PRPLANIT_DUNGEON_VELERO_SECRET_KEY=
PRPLANIT_DUNGEON_CNPG_GITLAB_ACCESS_KEY=
PRPLANIT_DUNGEON_CNPG_GITLAB_SECRET_KEY=
OPTCP_DUNGEON_CNPG_NEXTCLOUD_ACCESS_KEY=
OPTCP_DUNGEON_CNPG_NEXTCLOUD_SECRET_KEY=

# Bucket provisioner, used only by the nas-s3 flux Job.
NAS_S3_PROVISIONER_ACCESS_KEY=
NAS_S3_PROVISIONER_SECRET_KEY=

# Pre-rename velero bucket, read-only, for restoring old backups.
VELERO_BACKUPS_ACCESS_KEY=
VELERO_BACKUPS_SECRET_KEY=
