# This host's address, as other SeaweedFS nodes and clients are told to reach it.
# Must be routable from the cluster, never a container-internal address.
ADVERTISE_IP=172.22.150.101

# Where the data lives. No default in the compose — there is no safe guess.
DATA_DIR=/mnt/operation/PrecisionPlanIT/Servers/Gringotts/docker/seaweedfs/data

# Ports. The compose defaults to these already; they are stated here so the set
# in use is visible in one place and greppable against a firewall rule.
# SeaweedFS derives each gRPC port as its HTTP port + 10000 — move both together.
S3_PORT=8333
MASTER_PORT=9333
MASTER_GRPC_PORT=19333
VOLUME_PORT=8080
VOLUME_GRPC_PORT=18080
FILER_PORT=8888
FILER_GRPC_PORT=18888

# Capacity. VOLUME_MAX is a count of volumes, not a size. Set it explicitly.
VOLUME_MAX=1000
VOLUME_SIZE_LIMIT_MB=30000

# S3 identities. One per consumer, each scoped in docker-compose.yaml to its own
# prefix and nothing else. Nothing here is Admin.
# Names mirror the bucket path they open: uppercase, '/' -> '_'.
#
# Each key carries `# gitleaks:allow`. The names are long enough that gitleaks
# scores them as high-entropy generic-api-key hits even with no value after the
# `=`. Annotating the line is narrower than allowlisting the path: a real value
# pasted here would still have to be on one of these lines to be exempt, and a
# new variable added without the comment gets scanned normally.
PRPLANIT_DUNGEON_VELERO_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_VELERO_S3_SECRET_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_GITLAB_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_GITLAB_S3_SECRET_KEY= # gitleaks:allow
OPTCP_DUNGEON_CNPG_NEXTCLOUD_S3_ACCESS_KEY= # gitleaks:allow
OPTCP_DUNGEON_CNPG_NEXTCLOUD_S3_SECRET_KEY= # gitleaks:allow

# Bucket provisioner, used only by the nas-s3 flux Job.
NAS_S3_PROVISIONER_ACCESS_KEY= # gitleaks:allow
NAS_S3_PROVISIONER_SECRET_KEY= # gitleaks:allow

# Pre-rename velero bucket, read-only, for restoring old backups.
VELERO_BACKUPS_S3_ACCESS_KEY= # gitleaks:allow
VELERO_BACKUPS_S3_SECRET_KEY= # gitleaks:allow

# CNPG archives for the remaining database clusters.
PRPLANIT_DUNGEON_CNPG_ZITADEL_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_ZITADEL_S3_SECRET_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_NETBIRD_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_NETBIRD_S3_SECRET_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_VAULTWARDEN_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_VAULTWARDEN_S3_SECRET_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_HARBOR_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_HARBOR_S3_SECRET_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_CALCOM_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_CALCOM_S3_SECRET_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_BOUNDARY_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_BOUNDARY_S3_SECRET_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_GRAFANA_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_GRAFANA_S3_SECRET_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_GATUS_S3_ACCESS_KEY= # gitleaks:allow
PRPLANIT_DUNGEON_CNPG_GATUS_S3_SECRET_KEY= # gitleaks:allow
OPTCP_DUNGEON_CNPG_HOMARR_S3_ACCESS_KEY= # gitleaks:allow
OPTCP_DUNGEON_CNPG_HOMARR_S3_SECRET_KEY= # gitleaks:allow
OPTCP_DUNGEON_CNPG_APPFLOWY_S3_ACCESS_KEY= # gitleaks:allow
OPTCP_DUNGEON_CNPG_APPFLOWY_S3_SECRET_KEY= # gitleaks:allow
OPTCP_DUNGEON_CNPG_OPEN_WEBUI_S3_ACCESS_KEY= # gitleaks:allow
OPTCP_DUNGEON_CNPG_OPEN_WEBUI_S3_SECRET_KEY= # gitleaks:allow
OUTSPOKEKIN_DUNGEON_CNPG_MATRIX_S3_ACCESS_KEY= # gitleaks:allow
OUTSPOKEKIN_DUNGEON_CNPG_MATRIX_S3_SECRET_KEY= # gitleaks:allow
