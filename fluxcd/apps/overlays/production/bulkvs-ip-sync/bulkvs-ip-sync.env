# bulkvs-ip-sync runtime config (rendered into a hash-suffixed ConfigMap by the
# configMapGenerator, so any change here auto-rolls the pod). Secrets
# (BULKVS_API_USER / BULKVS_API_KEY) come from the ExternalSecret, not here.
#
# The description is the human label; the tool appends " (bulkvs-ip-sync)" as the
# ownership marker before writing, so the BulkVS entry reads
# "pbx.prplanit.com (bulkvs-ip-sync)". MaxOut mirrors the trunk's outbound-channel
# setting so a re-asserted entry keeps it. Egress must be the same WAN the trunk
# sits behind — this pod's cluster egress matches the PBX (single-WAN site).
BULKVS_HOST_DESCRIPTION=pbx.prplanit.com
BULKVS_MAX_OUT=2
IP_PROVIDER=cloudflare.trace
INTERVAL=5m
PRUNE=true
TZ=Etc/UTC
